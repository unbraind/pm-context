  scripts/verify-release-publish-attestation.ts,project,Publish option parsing and unreadable-source handling
  test/verify-release-publish-attestation.test.ts,project,Regression coverage for every unresolved verifier finding
tests[3]{command,path,scope,timeout_seconds,provenance{author,created_at,source_kind,source_ref}}:
  npm run coverage,test/verify-release-publish-attestation.test.ts,project,900,pi-agent,"2026-08-28T19:59:02.227Z",local_mutation,fix/refuse-unattested-publish-fallback
  ./node_modules/.bin/pm validate --check-history-drift --strict-exit --counts,.agents/pm/history,project,120,pi-agent,"2026-08-28T19:59:02.758Z",local_mutation,fix/refuse-unattested-publish-fallback
  ./node_modules/.bin/pm health --strict-exit --skip-vectors --brief,.agents/pm,project,120,pi-agent,"2026-08-28T19:59:03.374Z",local_mutation,fix/refuse-unattested-publish-fallback
close_reason: "Fixed in fix/refuse-unattested-publish-fallback; npm run release:check passed, npm run coverage passed at 100/100/100, and pm validate --check-history-drift --strict-exit --counts passed. The seven prior history records were restored unchanged and each received an explicit append-only correction event."
body: ""
