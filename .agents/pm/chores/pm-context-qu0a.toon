    path: .github/workflows/release.yml
    scope: project
    note: "release.yml parses; alert-on-release-failure job has if: failure(), needs release, permissions issues:write"
  - command: "test -n \"$(git config --local --get-regexp ^merge\\.pm)\""
    path: .
    scope: project
    note: "clone-local pm merge driver config is installed (gate proof recorded separately: health --strict-exit --require-merge-drivers exits 1 with all merge.pm-* sections removed, 0 after pm merge install)"
  - command: "npm run build:test && node --test test/alert-on-release-failure.test.ts"
    path: test/alert-on-release-failure.test.ts
    scope: project
