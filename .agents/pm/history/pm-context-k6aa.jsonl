ro exit without claiming to detect every silently discarded peer edit."},{"op":"add","path":"/metadata/actual_result","value":"The workflow had no PM health gate; latest toolchain resolution and merge-fence patterns were not consistently locked."},{"op":"add","path":"/metadata/dependencies","value":[{"id":"pm-context-5925","kind":"related","created_at":"2026-08-06T23:01:17.288Z","author":"codex","source_kind":"cli:create:dep","author_source":"asserted"}]},{"op":"add","path":"/metadata/files","value":[{"path":".github/workflows/ci.yml","scope":"project","note":"durable checkout health gate"},{"path":"package-lock.json","scope":"project","note":"pm CLI and pm-changelog 2026.8.6 resolution"}]},{"op":"add","path":"/metadata/tests","value":[{"command":"npm run release:check","scope":"project","timeout_seconds":900,"pm_context_mode":"tracker"},{"command":"pm health --strict-exit","scope":"project","timeout_seconds":120,"pm_context_mode":"tracker"}]},{"op":"add","path":"/metadata/docs","value":[{"path":"https://github.com/unbraind/pm-cli/issues/921","scope":"global","note":"repair erases durable drift evidence"},{"path":"https://github.com/unbraind/pm-cli/issues/922","scope":"global","note":"fresh clone can miss discarded scalar edit"}]}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"b141311b8de64dec8e696601f1b4951ac8674cb82087fe33b4d4fdf59320c64d","message":"Track exact durable health gate scope"}
