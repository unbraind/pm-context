{"hash_algorithm":"sha256","ts":"2026-10-29T21:09:56.658Z","author":"claude-hub","author_source":"asserted","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"0efcf6fa5f6489abf1ec4ce5","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null,"version":{"value":"2.1.312","source":"probe"}},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-10-29T21:09:56.658Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-10-29T21:09:56.658Z","author":"claude-hub","text":"Fixed in release.yml 'Restore prepared release notes': when the prepared commit has no section for NPM_VERSION, the step extracts the same-version section from origin/main (fetched and ancestry-verified by 'Verify merged release'), prints a notice, and still fails closed when neither has it. New test 'resume notes fall back to the same-version section of merged main when the prepared commit lacks it' builds a real git history (prepared commit without the section, later main commit with it, detached checkout) and also asserts a version absent everywhere refuses with empty RELEASE_NOTES.md. Revert proof: with the previous step the new test fails, with the fix it passes; release-workflow.test.ts 15/15. After this PR merges, dispatch release.yml to resume v2026.10.29."}]}],"before_hash":"c508a67710ac6e75988c02b76b4198eff092bfdb342adaa6928b3e42fc2a25da","after_hash":"5c41a692d9e2308998be5f75e7db7495bbe195d50464f80973d952401bbdbb45","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"c343d25b2acb08ecb58bace1649b89843e03e6459f2fc16fa28045fe6b5e63d5"}
