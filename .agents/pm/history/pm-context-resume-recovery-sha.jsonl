{"hash_algorithm":"sha256","ts":"2026-10-29T18:26:13.491Z","author":"codex-agent","author_source":"asserted","agent_harness":"codex","agent_model":"gpt-6.1-sol","agent_model_source":"probe","agent_instance":"54e929627d8281f325544727","agent_provenance":{"model":{"value":"gpt-6.1-sol","source":"probe"},"effort":{"value":"high","source":"probe"},"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-context-resume-recovery-sha"},{"op":"add","path":"/metadata/title","value":"Resume must consume a verified same-version changelog recovery"},{"op":"add","path":"/metadata/description","value":"The release decision selects the oldest untagged Release pm-context v commit and records its immutable SHA. Verify merged release checks out that SHA before Restore prepared release notes reads CHANGELOG.md. A later notes-only repair on main cannot repair the historical commit, so dispatch still refuses. Define and verify an explicitly authorized same-version recovery revision without weakening artifact, metadata, ancestry or gate checks. No dispatch or workflow mutation is part of the notes repair."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-10-29T18:26:13.491Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-10-29T18:26:13.491Z"},{"op":"add","path":"/metadata/author","value":"codex-agent"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"3dfa709c73466606fc0322380f6ccaf89516fb7d41fcdbf2c4b343264f1dccc4","item_hash_version":3,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"effort":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"}