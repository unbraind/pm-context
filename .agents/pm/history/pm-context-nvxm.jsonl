{"ts":"2026-08-31T11:15:58.563Z","author":"pi-agent","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.2:cloud","agent_model_source":"environment","agent_instance":"ecced4f54698766011ff3258","agent_provenance":{"model":{"value":"glm-5.2:cloud","source":"environment"},"effort":null,"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-context-nvxm"},{"op":"add","path":"/metadata/title","value":"Adjacent operator after a control closer leaves stale scope, suppressing later assignments"},{"op":"add","path":"/metadata/description","value":"A same-line control closer immediately followed by an operator is not recognised, e.g. if true; then echo ok; fi&&echo done — the fi is valid but not seen. The stale control scope then suppresses later file-scope assignments, so a subsequent $NPM publish is again unresolved. The closer expression excluded & and | from its trailing characters, so the closer was not recognised and the scope was never popped."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-08-31T11:15:58.563Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-08-31T11:15:58.563Z"},{"op":"add","path":"/metadata/author","value":"pi-agent"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"e6d689c9d485157b5cf4ef0182daf1d61c6bf2fb08ba43d8ac621f2f28c6efc2","item_hash_version":2,"message":""}
{"ts":"2026-08-31T11:17:28.908Z","author":"pi-agent","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.2:cloud","agent_model_source":"environment","agent_instance":"ecced4f54698766011ff3258","agent_provenance":{"model":{"value":"glm-5.2:cloud","source":"environment"},"effort":null,"role":null,"topic":null},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-08-31T11:17:28.908Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-08-31T11:17:28.908Z","author":"pi-agent","text":"Fix: the control closer, closesBrace, function opener, and opener self-close patterns now use the shared SEPARATORS constant which includes and-pipe and pipe characters. A closer followed by and-then or pipe is now recognised. Test: a control closer followed by an operator does not leave stale scope. Revert-proof: reverting SEPARATORS to only whitespace-semicolon-hash makes the test fail (0 != 1)."}]}],"before_hash":"e6d689c9d485157b5cf4ef0182daf1d61c6bf2fb08ba43d8ac621f2f28c6efc2","after_hash":"443ec46e884879b4a952d5614abf50182bb8e13631387ac7c309b9d484d273ec","item_hash_version":2}
