{"hash_algorithm":"sha256","ts":"2026-11-06T12:15:19.400Z","author":"codex-sol","author_source":"asserted","agent_harness":"codex","agent_model":"gpt-6.1-sol","agent_model_source":"probe","agent_instance":"0ec720e6d665535b19b621b1","agent_provenance":{"model":{"value":"gpt-6.1-sol","source":"probe"},"effort":{"value":"high","source":"probe"},"role":null,"topic":null},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/1","value":{"created_at":"2026-11-06T12:15:19.384Z","author":"codex-sol","text":"Implemented SDK estimatePmOutputTokens over UTF-8 bytes for facts, receipt overhead and projection ranking. JSON protocol overhead stabilizes including its final digits/newline. Handwritten TOON containers now use public host encodeToon (sdk/testing is the pinned host generic codec export); next-evidence retains encodePmTableRows and its complete encoding metadata. Freshness/evidence sizing stays in bytes, with SDK-encoded row costs. Existing direct TOON consumers also use the host codec. No whole-envelope estimated-token fitter exists here: context selection already delegates to packContextCandidates; since explicitly budgets utf8-bytes, so converting either byte contract to estimated tokens would violate G5."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-06T12:15:19.400Z"}],"before_hash":"7ea8550afa5af29da5381b8c46e13bac5e9a4cd612f59eecfe226ef23330a528","after_hash":"7670f4f95ac43f85bee9ca3eb5d7b695121cb93d1898c16b0a7b4b3a864ae5fd","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"effort":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"version":{"status":"unavailable","reason":"harness_unavailable","resolver":"ai_agent_version","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"04e2721478b93a8fc7bae253bd3062a24b48ebe93a8189c53233840e35d80aba"}
