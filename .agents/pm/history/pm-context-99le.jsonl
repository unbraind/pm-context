{"ts":"2026-08-31T11:15:40.755Z","author":"pi-agent","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.2:cloud","agent_model_source":"environment","agent_instance":"ecced4f54698766011ff3258","agent_provenance":{"model":{"value":"glm-5.2:cloud","source":"environment"},"effort":null,"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-context-99le"},{"op":"add","path":"/metadata/title","value":"Chained assignment followed by && or || hides publishes from the attestation gate"},{"op":"add","path":"/metadata/description","value":"A persistent assignment followed by && or || is not indexed by shellScalars. Given NPM=npm && true, a later $NPM publish stays unresolved and is omitted from publish recognition. The STANDALONE_ASSIGNMENT regex accepted only a semicolon, a comment, or end-of-line after the value, excluding the & and | operators. An attested sibling publish then satisfied the non-vacuity guard, so the whole scan returned clean while an unattested publish shipped."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-08-31T11:15:40.755Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-08-31T11:15:40.755Z"},{"op":"add","path":"/metadata/author","value":"pi-agent"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"6c6b111bed484dba1ae2357acb8227c0fc8635f278d11f3f9c2738650cc913a2","item_hash_version":2,"message":""}
{"ts":"2026-08-31T11:17:21.028Z","author":"pi-agent","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.2:cloud","agent_model_source":"environment","agent_instance":"ecced4f54698766011ff3258","agent_provenance":{"model":{"value":"glm-5.2:cloud","source":"environment"},"effort":null,"role":null,"topic":null},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-08-31T11:17:21.028Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-08-31T11:17:21.028Z","author":"pi-agent","text":"Fix: defined shared OPERATOR_CHARS and SEPARATORS constants. The STANDALONE_ASSIGNMENT trailing now uses OPERATOR_CHARS instead of just semicolon, so NPM=npm followed by and-then or or-then is indexed. Test: a chained assignment followed by an operator is still indexed. Revert-proof: reverting OPERATOR_CHARS back to semicolon makes the test fail (0 != 1)."}]}],"before_hash":"6c6b111bed484dba1ae2357acb8227c0fc8635f278d11f3f9c2738650cc913a2","after_hash":"36bd6ca49d319feaf26767cfb5ecb22075880553cc3791447190618fb5b624e7","item_hash_version":2}
